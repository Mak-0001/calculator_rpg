[sub_resource type="GDScript" id="GDScript_tn47a"]
script/source = "extends AbilityScript;


static func main(source: Ability) -> int:
	var output: int = randi_range(source.min_damage, source.max_damage);
	BattleMenager.add_battle_log(source.ability_name + \": \" + str(output));
	return output;
"
script = ExtResource("1_tn47a")
metadata/_custom_type_script = "uid://do7osdsmeas2s"

